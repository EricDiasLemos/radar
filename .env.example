# Renomeie este arquivo para .env e preencha os valores

# API Groq — gratuito em console.groq.com
GROQ_API_KEY=gsk_...

# Gmail — use "Senha de app", não a senha normal
# Google Account > Segurança > Verificação em duas etapas > Senhas de app
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email de destino das candidaturas (pode ser o mesmo do Gmail)
CANDIDATE_EMAIL=ericdias0603@gmail.com
